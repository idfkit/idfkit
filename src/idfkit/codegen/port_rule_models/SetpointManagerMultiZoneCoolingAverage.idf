! base: 5ZoneAirCooled.idf
! Appended to the base example so EnergyPlus reports this type's node connections in eplusout.bnd.
! Run for design days only by idfkit.codegen.generate_port_rules; not a modelling example.

  SetpointManager:MultiZone:Cooling:Average,
    Port Rule Cooling Average,  !- Name
    VAV Sys 1,               !- HVAC Air Loop Name
    12.0,                    !- Minimum Setpoint Temperature {C}
    18.0,                    !- Maximum Setpoint Temperature {C}
    VAV Sys 1 Inlet Node;    !- Setpoint Node or NodeList Name
