!-Generator idfkit v1.2.0
!-Option SortedOrder

Version,
  26.2;                    !- Version Identifier

Branch,
  USE Supply Inlet Branch,   !- Name
  ,                          !- Pressure Drop Curve Name
  Pump:VariableSpeed,        !- Component Object Type
  USE Pump,                  !- Component Name
  USE Supply Inlet Node,     !- Component Inlet Node Name
  USE Supply Pump-Heating Node; !- Component Outlet Node Name

Branch,
  USE Cooling Branch,        !- Name
  ,                          !- Pressure Drop Curve Name
  HeatExchanger:FluidToFluid, !- Component Object Type
  TRANSFER to USE HX,        !- Component Name
  USE Supply Cooling Inlet Node, !- Component Inlet Node Name
  USE Supply Cooling Outlet Node; !- Component Outlet Node Name

Branch,
  USE Supply Outlet Branch,  !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  USE Supply Outlet Pipe,    !- Component Name
  USE Supply Heating-Pipe Node, !- Component Inlet Node Name
  USE Supply Outlet Node;    !- Component Outlet Node Name

Branch,
  USE Demand Inlet Branch,   !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  USE Demand Inlet Pipe,     !- Component Name
  USE Demand Inlet Node,     !- Component Inlet Node Name
  USE Demand Pipe-Load Profile Node; !- Component Outlet Node Name

Branch,
  USE Load Profile Branch 1, !- Name
  ,                          !- Pressure Drop Curve Name
  LoadProfile:Plant,         !- Component Object Type
  Load Profile 1,            !- Component Name
  Demand Load Profile 1 Inlet Node, !- Component Inlet Node Name
  Demand Load Profile 1 Outlet Node; !- Component Outlet Node Name

Branch,
  USE Demand Outlet Branch,  !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  USE Demand Outlet Pipe,    !- Component Name
  USE Demand Load Profile-Pipe Node, !- Component Inlet Node Name
  USE Demand Outlet Node;    !- Component Outlet Node Name

Branch,
  TRANSFER Supply Inlet Branch, !- Name
  ,                          !- Pressure Drop Curve Name
  Pump:VariableSpeed,        !- Component Object Type
  TRANSFER Pump,             !- Component Name
  TRANSFER Supply Inlet Node, !- Component Inlet Node Name
  TRANSFER Supply Pump-Heating Node; !- Component Outlet Node Name

Branch,
  TRANSFER Cooling Branch,   !- Name
  ,                          !- Pressure Drop Curve Name
  HeatExchanger:FluidToFluid, !- Component Object Type
  SOURCE to TRANSFER HX,     !- Component Name
  TRANSFER Supply Cooling Inlet Node, !- Component Inlet Node Name
  TRANSFER Supply Cooling Outlet Node; !- Component Outlet Node Name

Branch,
  TRANSFER Supply Outlet Branch, !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  TRANSFER Supply Outlet Pipe, !- Component Name
  TRANSFER Supply Cooling-Pipe Node, !- Component Inlet Node Name
  TRANSFER Supply Outlet Node; !- Component Outlet Node Name

Branch,
  TRANSFER Demand Inlet Branch, !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  TRANSFER Demand Inlet Pipe, !- Component Name
  TRANSFER Demand Inlet Node, !- Component Inlet Node Name
  TRANSFER Demand Pipe-Load Profile Node; !- Component Outlet Node Name

Branch,
  TRANSFER Demand HX Branch 1, !- Name
  ,                          !- Pressure Drop Curve Name
  HeatExchanger:FluidToFluid, !- Component Object Type
  TRANSFER to USE HX,        !- Component Name
  TRANSFER Demand HX Inlet Node, !- Component Inlet Node Name
  TRANSFER Demand HX Outlet Node; !- Component Outlet Node Name

Branch,
  TRANSFER Demand Outlet Branch, !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  TRANSFER Demand Outlet Pipe, !- Component Name
  TRANSFER Demand HX-Pipe Node, !- Component Inlet Node Name
  TRANSFER Demand Outlet Node; !- Component Outlet Node Name

Branch,
  SOURCE Supply Inlet Branch, !- Name
  ,                          !- Pressure Drop Curve Name
  Pump:VariableSpeed,        !- Component Object Type
  SOURCE Pump,               !- Component Name
  SOURCE Supply Inlet Node,  !- Component Inlet Node Name
  SOURCE Supply Pump-Cooling Node; !- Component Outlet Node Name

Branch,
  SOURCE Cooling Branch,     !- Name
  ,                          !- Pressure Drop Curve Name
  DistrictCooling,           !- Component Object Type
  SOURCE Purchased Cooling,  !- Component Name
  SOURCE Supply Cooling Inlet Node, !- Component Inlet Node Name
  SOURCE Supply Cooling Outlet Node; !- Component Outlet Node Name

Branch,
  SOURCE Supply Outlet Branch, !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  SOURCE Supply Outlet Pipe, !- Component Name
  SOURCE Supply Cooling-Pipe Node, !- Component Inlet Node Name
  SOURCE Supply Outlet Node; !- Component Outlet Node Name

Branch,
  SOURCE Demand Inlet Branch, !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  SOURCE Demand Inlet Pipe,  !- Component Name
  SOURCE Demand Inlet Node,  !- Component Inlet Node Name
  SOURCE Demand Pipe-Load Profile Node; !- Component Outlet Node Name

Branch,
  SOURCE Demand HX Branch,   !- Name
  ,                          !- Pressure Drop Curve Name
  HeatExchanger:FluidToFluid, !- Component Object Type
  SOURCE to TRANSFER HX,     !- Component Name
  SOURCE Demand HX Inlet Node, !- Component Inlet Node Name
  SOURCE Demand HX Outlet Node; !- Component Outlet Node Name

Branch,
  SOURCE Demand Outlet Branch, !- Name
  ,                          !- Pressure Drop Curve Name
  Pipe:Adiabatic,            !- Component Object Type
  SOURCE Demand Outlet Pipe, !- Component Name
  SOURCE Demand HX-Pipe Node, !- Component Inlet Node Name
  SOURCE Demand Outlet Node; !- Component Outlet Node Name

BranchList,
  USE Supply Branches,       !- Name
  USE Supply Inlet Branch,   !- Branch Name
  USE Cooling Branch,        !- Branch Name 2
  USE Supply Outlet Branch;  !- Branch Name 3

BranchList,
  USE Demand Branches,       !- Name
  USE Demand Inlet Branch,   !- Branch Name
  USE Load Profile Branch 1, !- Branch Name 2
  USE Demand Outlet Branch;  !- Branch Name 3

BranchList,
  TRANSFER Supply Branches,  !- Name
  TRANSFER Supply Inlet Branch, !- Branch Name
  TRANSFER Cooling Branch,   !- Branch Name 2
  TRANSFER Supply Outlet Branch; !- Branch Name 3

BranchList,
  TRANSFER Demand Branches,  !- Name
  TRANSFER Demand Inlet Branch, !- Branch Name
  TRANSFER Demand HX Branch 1, !- Branch Name 2
  TRANSFER Demand Outlet Branch; !- Branch Name 3

BranchList,
  SOURCE Supply Branches,    !- Name
  SOURCE Supply Inlet Branch, !- Branch Name
  SOURCE Cooling Branch,     !- Branch Name 2
  SOURCE Supply Outlet Branch; !- Branch Name 3

BranchList,
  SOURCE Demand Branches,    !- Name
  SOURCE Demand Inlet Branch, !- Branch Name
  SOURCE Demand HX Branch,   !- Branch Name 2
  SOURCE Demand Outlet Branch; !- Branch Name 3

Building,
  Plant Load Profile Example, !- Name
  0,                         !- North Axis
  Suburbs,                   !- Terrain
  0.04,                      !- Loads Convergence Tolerance Value
  0.04,                      !- Temperature Convergence Tolerance Value
  FullInteriorAndExterior,   !- Solar Distribution
  25,                        !- Maximum Number Of Warmup Days
  6;                         !- Minimum Number Of Warmup Days

Connector:Mixer,
  USE Supply Mixer,          !- Name
  USE Supply Outlet Branch,  !- Outlet Branch Name
  USE Cooling Branch;        !- Inlet Branch Name

Connector:Mixer,
  USE Demand Mixer,          !- Name
  USE Demand Outlet Branch,  !- Outlet Branch Name
  USE Load Profile Branch 1; !- Inlet Branch Name

Connector:Mixer,
  TRANSFER Supply Mixer,     !- Name
  TRANSFER Supply Outlet Branch, !- Outlet Branch Name
  TRANSFER Cooling Branch;   !- Inlet Branch Name

Connector:Mixer,
  TRANSFER Demand Mixer,     !- Name
  TRANSFER Demand Outlet Branch, !- Outlet Branch Name
  TRANSFER Demand HX Branch 1; !- Inlet Branch Name

Connector:Mixer,
  SOURCE Supply Mixer,       !- Name
  SOURCE Supply Outlet Branch, !- Outlet Branch Name
  SOURCE Cooling Branch;     !- Inlet Branch Name

Connector:Mixer,
  SOURCE Demand Mixer,       !- Name
  SOURCE Demand Outlet Branch, !- Outlet Branch Name
  SOURCE Demand HX Branch;   !- Inlet Branch Name

Connector:Splitter,
  USE Supply Splitter,       !- Name
  USE Supply Inlet Branch,   !- Inlet Branch Name
  USE Cooling Branch;        !- Outlet Branch Name

Connector:Splitter,
  USE Demand Splitter,       !- Name
  USE Demand Inlet Branch,   !- Inlet Branch Name
  USE Load Profile Branch 1; !- Outlet Branch Name

Connector:Splitter,
  TRANSFER Supply Splitter,  !- Name
  TRANSFER Supply Inlet Branch, !- Inlet Branch Name
  TRANSFER Cooling Branch;   !- Outlet Branch Name

Connector:Splitter,
  TRANSFER Demand Splitter,  !- Name
  TRANSFER Demand Inlet Branch, !- Inlet Branch Name
  TRANSFER Demand HX Branch 1; !- Outlet Branch Name

Connector:Splitter,
  SOURCE Supply Splitter,    !- Name
  SOURCE Supply Inlet Branch, !- Inlet Branch Name
  SOURCE Cooling Branch;     !- Outlet Branch Name

Connector:Splitter,
  SOURCE Demand Splitter,    !- Name
  SOURCE Demand Inlet Branch, !- Inlet Branch Name
  SOURCE Demand HX Branch;   !- Outlet Branch Name

ConnectorList,
  USE Supply Connectors,     !- Name
  Connector:Splitter,        !- Connector 1 Object Type
  USE Supply Splitter,       !- Connector 1 Name
  Connector:Mixer,           !- Connector 2 Object Type
  USE Supply Mixer;          !- Connector 2 Name

ConnectorList,
  USE Demand Connectors,     !- Name
  Connector:Splitter,        !- Connector 1 Object Type
  USE Demand Splitter,       !- Connector 1 Name
  Connector:Mixer,           !- Connector 2 Object Type
  USE Demand Mixer;          !- Connector 2 Name

ConnectorList,
  TRANSFER Supply Connectors, !- Name
  Connector:Splitter,        !- Connector 1 Object Type
  TRANSFER Supply Splitter,  !- Connector 1 Name
  Connector:Mixer,           !- Connector 2 Object Type
  TRANSFER Supply Mixer;     !- Connector 2 Name

ConnectorList,
  TRANSFER Demand Connectors, !- Name
  Connector:Splitter,        !- Connector 1 Object Type
  TRANSFER Demand Splitter,  !- Connector 1 Name
  Connector:Mixer,           !- Connector 2 Object Type
  TRANSFER Demand Mixer;     !- Connector 2 Name

ConnectorList,
  SOURCE Supply Connectors,  !- Name
  Connector:Splitter,        !- Connector 1 Object Type
  SOURCE Supply Splitter,    !- Connector 1 Name
  Connector:Mixer,           !- Connector 2 Object Type
  SOURCE Supply Mixer;       !- Connector 2 Name

ConnectorList,
  SOURCE Demand Connectors,  !- Name
  Connector:Splitter,        !- Connector 1 Object Type
  SOURCE Demand Splitter,    !- Connector 1 Name
  Connector:Mixer,           !- Connector 2 Object Type
  SOURCE Demand Mixer;       !- Connector 2 Name

DistrictCooling,
  SOURCE Purchased Cooling,  !- Name
  SOURCE Supply Cooling Inlet Node, !- Chilled Water Inlet Node Name
  SOURCE Supply Cooling Outlet Node, !- Chilled Water Outlet Node Name
  1e+06;                     !- Nominal Capacity

GlobalGeometryRules,
  UpperLeftCorner,           !- Starting Vertex Position
  CounterClockWise,          !- Vertex Entry Direction
  Relative;                  !- Coordinate System

HeatExchanger:FluidToFluid,
  TRANSFER to USE HX,        !- Name
  AlwaysOnSchedule,          !- Availability Schedule Name
  TRANSFER Demand HX Inlet Node, !- Loop Demand Side Inlet Node Name
  TRANSFER Demand HX Outlet Node, !- Loop Demand Side Outlet Node Name
  0.003,                     !- Loop Demand Side Design Flow Rate
  USE Supply Cooling Inlet Node, !- Loop Supply Side Inlet Node Name
  USE Supply Cooling Outlet Node, !- Loop Supply Side Outlet Node Name
  0.003,                     !- Loop Supply Side Design Flow Rate
  CounterFlow,               !- Heat Exchange Model Type
  10000,                     !- Heat Exchanger U Factor Times Area Value
  CoolingSetpointModulated,  !- Control Type
  Use Supply Outlet Node,    !- Heat Exchanger Setpoint Node Name
  0.2,                       !- Minimum Temperature Difference To Activate Heat Exchanger
  LoopToLoop;                !- Heat Transfer Metering End Use Type

HeatExchanger:FluidToFluid,
  SOURCE to TRANSFER HX,     !- Name
  AlwaysOnSchedule,          !- Availability Schedule Name
  SOURCE Demand HX Inlet Node, !- Loop Demand Side Inlet Node Name
  SOURCE Demand HX Outlet Node, !- Loop Demand Side Outlet Node Name
  0.003,                     !- Loop Demand Side Design Flow Rate
  TRANSFER Supply Cooling Inlet Node, !- Loop Supply Side Inlet Node Name
  TRANSFER Supply Cooling Outlet Node, !- Loop Supply Side Outlet Node Name
  0.003,                     !- Loop Supply Side Design Flow Rate
  CrossFlowBothMixed,        !- Heat Exchange Model Type
  10000,                     !- Heat Exchanger U Factor Times Area Value
  OperationSchemeModulated,  !- Control Type
  TRANSFER Supply Outlet Node, !- Heat Exchanger Setpoint Node Name
  0.2,                       !- Minimum Temperature Difference To Activate Heat Exchanger
  LoopToLoop;                !- Heat Transfer Metering End Use Type

LoadProfile:Plant,
  Load Profile 1,            !- Name
  Demand Load Profile 1 Inlet Node, !- Inlet Node Name
  Demand Load Profile 1 Outlet Node, !- Outlet Node Name
  Load Profile 1 Load Schedule, !- Load Schedule Name
  0.002,                     !- Peak Flow Rate
  Load Profile 1 Flow Frac Schedule, !- Flow Rate Fraction Schedule Name
  Water;                     !- Plant Loop Fluid Type

NodeList,
  Use Loop Setpoint Node List, !- Name
  Use Supply Outlet Node;    !- Node Name

NodeList,
  TRANSFER Loop Setpoint Node List, !- Name
  TRANSFER Supply Outlet Node; !- Node Name

NodeList,
  SOURCE Loop Setpoint Node List, !- Name
  SOURCE Supply Outlet Node; !- Node Name

Output:Meter:MeterFileOnly,
  Cooling:DistrictCooling,   !- Key Name
  monthly;                   !- Reporting Frequency

Output:Meter:MeterFileOnly,
  Cooling:DistrictCooling,   !- Key Name
  runperiod;                 !- Reporting Frequency

Output:Meter:MeterFileOnly,
  Electricity:Facility,      !- Key Name
  monthly;                   !- Reporting Frequency

Output:Meter:MeterFileOnly,
  Electricity:Plant,         !- Key Name
  monthly;                   !- Reporting Frequency

Output:Meter:MeterFileOnly,
  Electricity:Facility,      !- Key Name
  runperiod;                 !- Reporting Frequency

Output:Meter:MeterFileOnly,
  Electricity:Plant,         !- Key Name
  runperiod;                 !- Reporting Frequency

Output:SQLite,
  SimpleAndTabular;          !- Option Type

Output:Table:SummaryReports,
  AllSummary;                !- Report Name

Output:Variable,
  *,                         !- Key Value
  Plant Load Profile Mass Flow Rate, !- Variable Name
  Hourly;                    !- Reporting Frequency

Output:Variable,
  *,                         !- Key Value
  Plant Load Profile Heat Transfer Rate, !- Variable Name
  Hourly;                    !- Reporting Frequency

